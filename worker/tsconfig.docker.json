// Docker-only variant of tsconfig.json (tsconfig supports JSONC comments). lib/marketplaces and
// lib/storage get copied to ./lib/... (children of WORKDIR, alongside node_modules) instead of
// ../lib/... (a sibling, matching the real repo layout) -- Node's module resolution only walks
// UP from an importing file looking for node_modules, so a copy destination that isn't a real
// ancestor-descendant of node_modules breaks the plain `import("playwright-core")` inside
// playwright-runner.ts even though the @/ alias itself still resolves fine. baseUrl "." (not
// "..") is what keeps @/lib/marketplaces pointed at the right place under this layout. See
// worker/Dockerfile.
{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src/**/*.ts", "lib/marketplaces/**/*.ts", "lib/storage/**/*.ts"],
  "exclude": ["node_modules"]
}
