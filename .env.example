# Neon (PostgreSQL) connection strings
# Pooled connection for the app (use the -pooler endpoint)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct connection for Prisma CLI migrations (non-pooled endpoint)
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"
# 64-char hex used to encrypt marketplace OAuth tokens at rest. Keep this one narrowly held --
# a leak decrypts every stored marketplace password. Deliberately NOT reused for anything else.
MASTER_KEY="generate-a-64-char-hex-key-and-set-in-vercel-env"

# Background job queue (Inngest) -- see lib/inngest/.
# Local dev: set INNGEST_DEV=1 and run `npx inngest-cli@latest dev` alongside `npm run dev` --
# leave INNGEST_EVENT_KEY/INNGEST_SIGNING_KEY unset, the SDK talks to the dev server instead.
INNGEST_DEV=1
# Production: unset INNGEST_DEV, get both of these from an app at https://app.inngest.com
# INNGEST_EVENT_KEY="get-from-inngest-dashboard"
# INNGEST_SIGNING_KEY="get-from-inngest-dashboard"

# Browser worker (Playwright automation for manual-adapter platforms) -- see worker/README.md.
# Production only: unset locally, those platforms run in-process instead, no worker needed.
# BROWSER_WORKER_URL="https://your-worker.up.railway.app"
# BROWSER_WORKER_SECRET="generate-a-64-char-hex-key-and-set-on-both-sides"

# Marketplace API credentials (add real values to enable live posting)
# EBAY_APP_ID=your_ebay_app_id
# EBAY_CERT_ID=your_ebay_cert_id
# EBAY_DEV_ID=your_ebay_dev_id
# EBAY_RU_NAME=your_ebay_ru_name  # redirect URI should be NEXTAUTH_URL/api/marketplace/callback/ebay
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_CATEGORY_ID=your_default_category_id
# EBAY_MERCHANT_LOCATION_KEY=optional
# Payment/return/fulfillment policies aren't set via env vars -- they're read from the
# connected seller's own eBay account (Sell > Account > Business policies) at post time,
# or from a MarketplaceAccount's settings JSON if set there instead.
# ETSY_API_KEY=your_etsy_api_key  # redirect URI should be NEXTAUTH_URL/api/marketplace/callback/etsy
# ETSY_TAXONOMY_ID=your_default_taxonomy_id
# ETSY_SHIPPING_PROFILE_ID=your_shipping_profile_id
# ETSY_WHO_MADE=someone_else
# ETSY_WHEN_MADE=2020_2024
# ETSY_IS_SUPPLY=false

# Stripe billing (hosted Checkout is used, so no publishable key is needed client-side)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_LAUNCH=price_...
# STRIPE_PRICE_GROW=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_SCALE=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# STRIPE_PRICE_LAUNCH_ANNUAL=price_...
# STRIPE_PRICE_GROW_ANNUAL=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_SCALE_ANNUAL=price_...

# OpenAI API key (optional; used for AI listing generation from optimization)
# OPENAI_API_KEY=sk-...

# Background removal provider: birefnet (default, fal-hosted MIT weights) | photoroom
# BG_REMOVER=birefnet
# fal.ai key for BiRefNet (format key_id:key_secret)
# FAL_KEY=...
# Optional BiRefNet tuning; see fal-ai/birefnet/v2 docs
# BIREFNET_MODEL=General Use (Light)
# BIREFNET_RESOLUTION=1024x1024
# PhotoRoom API key (premium fallback for hair/sheer/white-on-white cases)
# PHOTOROOM_API_KEY=...

# Resend API key, used to send password-reset emails. Without it, requestPasswordReset()
# silently fails to deliver (logs the error but still returns success, so it never leaks
# whether an email is registered) -- required for the forgot-password flow to actually work.
# RESEND_API_KEY=re_...
# From address for outgoing email; must be a domain verified in Resend. Uses a dedicated
# subdomain rather than the root domain so its SPF/DKIM never touch postmost.co's real
# Outlook/M365 mail setup.
# EMAIL_FROM="PostMost <noreply@mail.postmost.co>"

# Image storage (Cloudflare R2 by default; S3-compatible so it stays portable)
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET="postmost-photos"
# Public CDN / custom domain base URL images are served from (no trailing slash)
R2_PUBLIC_BASE_URL="https://images.example.com"
# Override the S3 endpoint to use another S3-compatible host (e.g. MinIO locally);
# unset means Cloudflare R2 at https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT=http://localhost:9000
# Optional extra hostnames allowed for next/image (comma-separated)
# NEXT_IMAGE_HOSTS=cdn.example.com
