# Neon (PostgreSQL) connection strings
# Pooled connection for the app (use the -pooler endpoint)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct connection for Prisma CLI migrations (non-pooled endpoint)
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# Marketplace API credentials (add real values to enable live posting)
# EBAY_APP_ID=your_ebay_app_id
# EBAY_CERT_ID=your_ebay_cert_id
# EBAY_DEV_ID=your_ebay_dev_id
# EBAY_RU_NAME=your_ebay_ru_name
# ETSY_API_KEY=your_etsy_api_key
# ETSY_API_SECRET=your_etsy_api_secret
