# Neon (PostgreSQL) connection strings
# Pooled connection for the app (use the -pooler endpoint)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct connection for Prisma CLI migrations (non-pooled endpoint)
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"
# Absolute base URL used to trigger the background job worker (falls back to NEXTAUTH_URL)
APP_URL="http://localhost:3000"
# 64-char hex used to encrypt marketplace OAuth tokens at rest.
# Also authorizes manual calls to /api/jobs/run via the x-master-key header.
MASTER_KEY="generate-a-64-char-hex-key-and-set-in-vercel-env"
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to /api/jobs/run
CRON_SECRET="generate-a-random-secret"

# Marketplace API credentials (add real values to enable live posting)
# EBAY_APP_ID=your_ebay_app_id
# EBAY_CERT_ID=your_ebay_cert_id
# EBAY_DEV_ID=your_ebay_dev_id
# EBAY_RU_NAME=your_ebay_ru_name  # redirect URI should be NEXTAUTH_URL/api/marketplace/callback/ebay
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_CATEGORY_ID=your_default_category_id
# EBAY_PAYMENT_POLICY_ID=optional
# EBAY_RETURN_POLICY_ID=optional
# EBAY_FULFILLMENT_POLICY_ID=optional
# EBAY_MERCHANT_LOCATION_KEY=optional
# ETSY_API_KEY=your_etsy_api_key
# ETSY_API_SECRET=your_etsy_api_secret  # redirect URI should be NEXTAUTH_URL/api/marketplace/callback/etsy
# ETSY_SHARED_SECRET=your_etsy_shared_secret
# ETSY_TAXONOMY_ID=your_default_taxonomy_id
# ETSY_SHIPPING_PROFILE_ID=your_shipping_profile_id
# ETSY_WHO_MADE=someone_else
# ETSY_WHEN_MADE=2020_2024
# ETSY_IS_SUPPLY=false

# Inventory webhook secret (used to verify incoming sale webhooks)
# INVENTORY_WEBHOOK_SECRET=change-me

# Stripe billing
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_LAUNCH=price_...
# STRIPE_PRICE_GROW=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_SCALE=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# STRIPE_PRICE_LAUNCH_ANNUAL=price_...
# STRIPE_PRICE_GROW_ANNUAL=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_SCALE_ANNUAL=price_...

# OpenAI API key (optional; used for AI listing generation from optimization)
# OPENAI_API_KEY=sk-...

# Remove.bg API key (optional; used for AI background removal)
# REMOVE_BG_API_KEY=...
