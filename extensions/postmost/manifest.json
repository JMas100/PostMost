{
  "manifest_version": 3,
  "name": "PostMost",
  "version": "1.1.0",
  "description": "Post one listing to Facebook Marketplace, OfferUp, Poshmark, Mercari, Depop, Vinted, Grailed, and Craigslist from PostMost.",
  "permissions": ["storage", "cookies"],
  "host_permissions": [
    "https://postmost.co/*",
    "http://localhost:3000/*",
    "https://*.facebook.com/*",
    "https://*.offerup.com/*",
    "https://*.poshmark.com/*",
    "https://*.mercari.com/*",
    "https://*.depop.com/*",
    "https://*.vinted.com/*",
    "https://*.grailed.com/*",
    "https://*.craigslist.org/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://postmost.co/*",
        "http://localhost:3000/*"
      ],
      "js": ["src/postmost-content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.offerup.com/*",
        "https://*.poshmark.com/*",
        "https://*.mercari.com/*",
        "https://*.depop.com/*",
        "https://*.vinted.com/*",
        "https://*.grailed.com/*",
        "https://*.craigslist.org/*"
      ],
      "js": ["src/shared.js", "src/platforms.js", "src/fill-form.js", "src/marketplace-content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
